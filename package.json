{
  "name": "remoteHercules",
  "version": "1.0.0",
  "description": "Hercules DJ Starlight MIDI bridge to FlexRadio (SmartSDR / AetherSDR MultiFlex)",
  "main": "app.js",
  "bin": "app.js",
  "scripts": {
    "start": "node app.js",
    "editor": "node configeditor.js",
    "build:exe": "pkg . --output dist/xxHercules.exe && node scripts/copy-dist-assets.js && node scripts/zip-dist.js",
    "prebuild": "npm run test:hw",
    "build": "npm run build:exe",
    "test": "node --test ./test/flexdominator.test.js ./test/configeditor-api.test.js",
    "test:hw": "node --test ./test/hardware.test.js",
    "test:flex": "node --test ./test/flex-live.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "easymidi": "^3.1.0",
    "flexradio-js": "^1.1.0",
    "read-excel-file": "^5.7.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.12.0"
  },
  "allowScripts": {
    "@julusian/midi@3.1.0": true
  },
  "pkg": {
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist",
    "assets": [
      "node_modules/@julusian/midi/prebuilds/**/*"
    ],
    "publicPackages": [
      "*"
    ]
  }
}
